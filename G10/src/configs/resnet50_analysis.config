output_folder          ../results/ResNet50
is_simulation          1
is_resnet              1
batch_size             16
input_H                224
input_W                224
num_iteration          1
num_threads            128
nn_model_input_file    ../frontend/Nets/ResNet50.txt

# 三个时间文件都指向阶段 A 产出的同一份（任务一不做预取实验，PF/InputPF 复用 orig）
orig_kernel_time_file     ../results/ResNet50/cudnn_kernel_times.txt
pf_kernel_time_file       ../results/ResNet50/cudnn_kernel_times.txt
input_pf_kernel_time_file ../results/ResNet50/cudnn_kernel_times.txt
workspace_size_file       ../results/ResNet50/cudnn_workspace_sizes.txt

stat_output_file        sim_result
is_UVM                  1
use_prefetch            0
eviction_policy         LRU

# 以下为 is_simulation=1 必填硬件参数（SimulationParamSanityCheck 会校验），按 5060 近似填
GPU_memory_size_GB      8
GPU_frequency_GHz       2.5
GPU_PCIe_bandwidth_GBps 15.754
GPU_malloc_uspB         0.000000814
GPU_free_uspB           0
CPU_PCIe_bandwidth_GBps 15.754
CPU_memory_line_GB      128
SSD_PCIe_bandwidth_GBps 3.2
SSD_read_latency_us     12
SSD_write_latency_us    16
SSD_latency_us          20
PCIe_latency_us         5
PCIe_batch_size_page    50
system_latency_us       45
delta_parameter         0.5